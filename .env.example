# Replace PASSWORD locally with the URL-encoded password. Never commit real secrets.
DATABASE_URL=postgres://inventory_service:PASSWORD@127.0.0.1:5433/inventory_db?sslmode=disable
JWT_PUBLIC_KEY_PATH=keys/auth-public.pem
JWT_ISSUER=erp-auth
JWT_AUDIENCE=erp-api
PORT=8082
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STARTUP_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=5s
READINESS_TIMEOUT=2s
HTTP_MAX_BODY_BYTES=1048576
HTTP_SLOW_REQUEST_THRESHOLD=500ms
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Requires real HTTPS reference configuration and separately granted human permission.
OPENING_STOCK_ENABLED=false
